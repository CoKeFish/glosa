server {
    listen 80;
    root /usr/share/nginx/html;
    client_max_body_size 200m;  # book imports

    location /api/ {
        proxy_pass http://${GLOSA_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_read_timeout 300s;  # AI answers and imports can take a while
    }
    location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }
    # The app routes in the browser: every other path is the app.
    location / { try_files $uri /index.html; }
}
