# The released web app: built once, served by nginx, which also passes /api to the API.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install
COPY . .
RUN npm run build

FROM nginx:1.29-alpine
# nginx renders templates with the environment at start: where the API is can change per
# deployment (on a shared Docker network, a unique container name beats "api").
ENV GLOSA_API_UPSTREAM=api:8000
COPY nginx.release.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
